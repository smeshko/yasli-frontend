---
import SiteFooter from "@/components/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Ясли и детски градини във Варна.",
} = Astro.props;

const normalizePath = (path: string) => {
  const normalizedPath = path.replace(/\/+$/, "");
  return normalizedPath === "" ? "/" : normalizedPath;
};

const pathname = normalizePath(Astro.url.pathname);

// Temporarily hidden while the /pravila copy is being reworked.
const showNav = false;

const navItems = [
  { href: "/", label: "Търсене" },
  { href: "/pravila", label: "Правила за прием" },
].map((item) => ({
  ...item,
  active: pathname === normalizePath(item.href),
}));
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Начало">
        <img alt="" height="32" src="/favicon.svg" width="32" />
      </a>
      {
        showNav && (
          <Fragment>
            <button
              aria-controls="site-nav"
              aria-expanded="false"
              aria-label="Отвори меню"
              class="nav-toggle"
              data-nav-toggle
              type="button"
            >
              <span aria-hidden="true" />
              <span aria-hidden="true" />
              <span aria-hidden="true" />
            </button>
            <nav aria-label="Основна навигация" data-site-nav id="site-nav">
              {navItems.map((item) => (
                <a aria-current={item.active ? "page" : undefined} href={item.href}>
                  {item.label}
                </a>
              ))}
              <SiteFooter class="site-footer--mobile" />
            </nav>
          </Fragment>
        )
      }
    </header>
    <main>
      <slot />
    </main>
    <SiteFooter class={showNav ? "site-footer--desktop" : undefined} />
    <script>
      const header = document.querySelector(".site-header");
      const nav = document.querySelector("[data-site-nav]");
      const toggle = document.querySelector("[data-nav-toggle]");

      const setNavOpen = (isOpen: boolean) => {
        header?.toggleAttribute("data-nav-open", isOpen);
        toggle?.setAttribute("aria-expanded", String(isOpen));
        toggle?.setAttribute("aria-label", isOpen ? "Затвори меню" : "Отвори меню");
      };

      toggle?.addEventListener("click", () => {
        setNavOpen(toggle.getAttribute("aria-expanded") !== "true");
      });

      nav?.addEventListener("click", (event) => {
        if (event.target instanceof Element && event.target.closest("a")) {
          setNavOpen(false);
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          setNavOpen(false);
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;

    --color-bg-page: #f4f7fb;
    --color-bg-surface: #ffffff;
    --color-bg-surface-muted: rgba(255, 255, 255, 0.72);
    --color-bg-accent-soft: #e7f0ff;
    --color-bg-accent-softer: #eef4ff;
    --color-bg-error-soft: #fff7ed;
    --color-bg-warn-soft: #fef9c3;

    --color-border-subtle: #d6dfeb;
    --color-border-default: #cbd5e1;
    --color-border-soft: #c9d8ef;
    --color-border-card: #d6e0ee;
    --color-border-status: #cbd7d0;
    --color-border-accent: #6fa3ff;
    --color-border-error: #f3b4a6;
    --color-border-warn: #d8b84c;

    --color-text-strong: #0f172a;
    --color-text-display: #081225;
    --color-text-muted: #475569;
    --color-text-subtle: #59677d;
    --color-text-faint: #7d8ba4;
    --color-text-eyebrow: #5b6861;
    --color-text-status: #30514a;
    --color-text-error: #9a3412;
    --color-text-error-strong: #b42318;
    --color-text-group-note: #1e3a8a;
    --color-text-warn: #713f12;
    --color-text-on-accent: #ffffff;

    --color-accent: #2563eb;
    --color-accent-strong: #1d4ed8;

    --shadow-field: 0 0 0 1px rgba(52, 108, 255, 0.04);
    --shadow-panel: 0 22px 44px rgba(31, 55, 88, 0.12);

    color: var(--color-text-strong);
    background: var(--color-bg-page);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-bg-page: #0b1220;
      --color-bg-surface: #131c2f;
      --color-bg-surface-muted: rgba(19, 28, 47, 0.72);
      --color-bg-accent-soft: rgba(96, 165, 250, 0.18);
      --color-bg-accent-softer: rgba(96, 165, 250, 0.1);
      --color-bg-error-soft: rgba(180, 83, 36, 0.2);
      --color-bg-warn-soft: rgba(202, 138, 4, 0.18);

      --color-border-subtle: #1f2a44;
      --color-border-default: #2a3654;
      --color-border-soft: #2a3654;
      --color-border-card: #28324d;
      --color-border-status: #2a3a36;
      --color-border-accent: #60a5fa;
      --color-border-error: rgba(244, 162, 97, 0.45);
      --color-border-warn: rgba(250, 204, 21, 0.45);

      --color-text-strong: #f1f5f9;
      --color-text-display: #ffffff;
      --color-text-muted: #cbd5e1;
      --color-text-subtle: #94a3b8;
      --color-text-faint: #64748b;
      --color-text-eyebrow: #a3b3c5;
      --color-text-status: #c1d6cf;
      --color-text-error: #fdba74;
      --color-text-error-strong: #fca5a5;
      --color-text-group-note: #bfdbfe;
      --color-text-warn: #fde68a;

      --color-accent: #3b82f6;
      --color-accent-strong: #60a5fa;

      --shadow-field: 0 0 0 1px rgba(96, 165, 250, 0.1);
      --shadow-panel: 0 22px 44px rgba(0, 0, 0, 0.45);
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    display: flex;
    min-width: 320px;
    height: 100vh;
    height: 100dvh;
    flex-direction: column;
    margin: 0;
    overflow: hidden;
    background: var(--color-bg-page);
  }

  .site-header {
    flex: 0 0 auto;
  }

  a {
    color: inherit;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 66px;
    border-bottom: 1px solid var(--color-border-subtle);
    background: var(--color-bg-surface);
    padding: 0 48px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--color-text-strong);
    text-decoration: none;
  }

  .brand img {
    display: block;
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    border: 1px solid var(--color-border-default);
    border-radius: 8px;
    background: var(--color-bg-surface);
    color: var(--color-text-strong);
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition:
      transform 160ms ease,
      opacity 160ms ease;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 28px;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    font-weight: 700;
  }

  nav a {
    position: relative;
    padding: 4px 0;
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease;
  }

  nav a::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -2px;
    left: 0;
    height: 2px;
    border-radius: 1px;
    background: var(--color-accent);
    opacity: 0;
    transition: opacity 160ms ease;
  }

  nav a[aria-current="page"] {
    color: var(--color-accent);
  }

  nav a[aria-current="page"]::after {
    opacity: 1;
  }

  .site-footer.site-footer--mobile {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-toggle:hover {
      border-color: var(--color-border-accent);
      color: var(--color-accent);
    }

    nav a:hover {
      color: var(--color-accent);
    }

    nav a:hover::after {
      opacity: 0.45;
    }
  }

  main {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .section-stack {
    display: grid;
    gap: 18px;
    width: min(100% - 32px, 1040px);
    max-width: 720px;
    margin: 0 auto;
    padding: 56px 0 72px;
  }

  .eyebrow {
    margin: 0;
    color: var(--color-text-eyebrow);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--color-text-display);
    font-size: clamp(2rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: 0;
  }

  p {
    max-width: 60ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 12px;
  }

  .button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-accent);
    border-radius: 8px;
    padding: 0 16px;
    background: var(--color-accent);
    color: var(--color-text-on-accent);
    font-weight: 700;
    text-decoration: none;
  }

  .status-badge {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    border: 1px solid var(--color-border-status);
    border-radius: 999px;
    padding: 6px 10px;
    background: var(--color-bg-surface);
    color: var(--color-text-status);
    font-size: 0.85rem;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .site-header {
      display: grid;
      grid-template-columns: auto auto;
      align-items: center;
      justify-content: space-between;
      gap: 8px 16px;
      min-height: 66px;
      padding: 12px 16px;
    }

    .nav-toggle {
      display: inline-flex;
    }

    .site-header[data-nav-open] .nav-toggle span:first-child {
      transform: translateY(7px) rotate(45deg);
    }

    .site-header[data-nav-open] .nav-toggle span:nth-child(2) {
      opacity: 0;
    }

    .site-header[data-nav-open] .nav-toggle span:last-child {
      transform: translateY(-7px) rotate(-45deg);
    }

    nav {
      grid-column: 1 / -1;
      display: grid;
      width: 100%;
      max-height: 0;
      gap: 4px;
      overflow: hidden;
      opacity: 0;
      pointer-events: none;
      transition:
        max-height 180ms ease,
        opacity 160ms ease;
    }

    .site-header[data-nav-open] nav {
      max-height: 260px;
      opacity: 1;
      pointer-events: auto;
    }

    nav a {
      min-height: 42px;
      padding: 10px 0;
    }

    nav a::after {
      bottom: 4px;
    }

    .site-footer.site-footer--desktop {
      display: none;
    }

    .site-footer.site-footer--mobile {
      display: flex;
      justify-content: flex-start;
      margin-top: 8px;
      padding: 12px 0 0;
      border-top: 1px solid var(--color-border-subtle);
      background: transparent;
      font-weight: 400;
    }

    .section-stack {
      width: min(100% - 24px, 1040px);
      padding-top: 40px;
    }
  }
</style>

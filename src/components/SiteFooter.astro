---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<footer class:list={["site-footer", className]}>
  <a href="https://ivotsonev.com" rel="noreferrer" target="_blank">
    Built by ivotsonev.com
  </a>
  {/* Filled in by the SearchExperience island once /api/institutions answers —
      the freshness date is site chrome, not part of the search, so it lives
      down here rather than under the field. Empty and hidden on pages that
      never mount the island. */}
  <span class="site-footer__freshness" data-footer-freshness hidden></span>
</footer>

<style is:global>
  .site-footer {
    display: flex;
    flex: 0 0 auto;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    border-top: 1px solid var(--color-border-subtle);
    /* Opaque for the same reason as the header — see BaseLayout .site-header. */
    background: var(--color-bg-page);
    color: var(--color-text-muted);
    /* The old monospace stack was the only mono on the site and read as a
       developer artefact on a page meant for parents. */
    font-family: inherit;
    font-size: 0.82rem;
    padding: 10px 16px;
  }

  /* Quieter than the credit next to it — it is a footnote about the data, not
     something to click. The separator hangs off the span so it disappears with
     it when there is no date. */
  .site-footer__freshness {
    color: var(--color-text-faint);
    font-size: 0.78rem;
  }

  .site-footer__freshness[hidden] {
    display: none;
  }

  .site-footer__freshness::before {
    content: "·";
    margin-right: 14px;
    color: var(--color-border-subtle);
  }

  .site-footer a {
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer a:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }
</style>

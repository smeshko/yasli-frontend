---
import { SearchExperience } from "@/components/SearchExperience";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Ясли" description="Търсене на ясли и детски градини по адрес във Варна.">
  <SearchExperience client:load />
</BaseLayout>

<style is:global>
  .search-experience {
    display: grid;
    min-height: 100%;
    grid-template-rows: 1fr auto;
    background: var(--color-bg-page);
  }

  .search-experience[data-has-results="true"] {
    grid-template-rows: auto 1fr;
  }

  .search-hero {
    display: grid;
    width: min(100% - 32px, 760px);
    align-content: start;
    justify-self: center;
    padding: max(48px, 32vh) 0 30px;
  }

  .search-experience[data-has-results="true"] .search-hero {
    padding: 48px 0 30px;
  }

  .search-copy {
    display: grid;
    gap: 20px;
    justify-items: center;
    margin-bottom: 26px;
    text-align: center;
  }

  .search-copy h1 {
    max-width: 720px;
    color: var(--color-text-display);
    font-size: clamp(2.5rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.12;
  }

  .search-copy p {
    max-width: 760px;
    color: var(--color-text-subtle);
    font-size: 1.08rem;
    line-height: 1.55;
  }

  .search-panel {
    position: relative;
    width: 100%;
  }

  .search-field {
    display: grid;
    min-height: 60px;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 14px;
    border: 2px solid var(--color-border-accent);
    border-radius: 9px;
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-field);
    color: var(--color-accent);
    padding: 0 18px;
  }

  .search-field input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-text-strong);
    font: inherit;
    font-size: 1rem;
    font-weight: 700;
  }

  .search-field input::placeholder {
    color: var(--color-text-faint);
    font-weight: 500;
  }

  .suggestion-panel {
    position: absolute;
    z-index: 10;
    top: calc(100% + 10px);
    left: 0;
    width: 100%;
    max-height: min(376px, 52dvh);
    overflow-y: auto;
    border: 1px solid var(--color-border-soft);
    border-radius: 10px;
    margin: 0;
    padding: 8px;
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-panel);
    list-style: none;
  }

  .suggestion-panel li {
    display: grid;
    min-height: 46px;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    border-radius: 8px;
    color: var(--color-text-subtle);
    cursor: pointer;
    padding: 9px 12px;
  }

  .suggestion-panel li.active {
    background: var(--color-bg-accent-soft);
    color: var(--color-accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .suggestion-panel li:hover {
      background: var(--color-bg-accent-soft);
      color: var(--color-accent);
    }
  }

  .suggestion-text {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 6px;
  }

  .suggestion-text strong {
    color: var(--color-text-strong);
    font-size: 0.94rem;
    white-space: nowrap;
  }

  .suggestion-text span {
    min-width: 0;
    overflow: hidden;
    color: var(--color-text-subtle);
    font-size: 0.9rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .row-icon,
  .arrow-icon {
    flex: 0 0 auto;
  }

  .status-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--color-text-muted);
    font-size: 0.94rem;
  }

  .status-panel button,
  .results-status button {
    border: 0;
    border-radius: 7px;
    background: var(--color-accent);
    color: var(--color-text-on-accent);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    padding: 8px 12px;
  }

  .validation-message {
    margin-top: 12px;
    color: var(--color-text-error-strong);
    font-size: 0.94rem;
  }

  .results-area {
    width: min(100% - 32px, 1040px);
    justify-self: center;
    padding: 0 0 56px;
  }

  .selected-address {
    max-width: none;
    color: var(--color-text-strong);
    font-weight: 700;
  }

  .results-status,
  .stale-banner {
    border: 1px solid var(--color-border-soft);
    border-radius: 8px;
    margin-top: 18px;
    background: var(--color-bg-surface);
    color: var(--color-text-muted);
    padding: 16px;
  }

  .results-status.error,
  .stale-banner {
    border-color: var(--color-border-error);
    background: var(--color-bg-error-soft);
    color: var(--color-text-error);
  }

  .results-status.error {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0;
  }

  .filters button {
    min-height: 44px;
    border: 1px solid var(--color-border-default);
    border-radius: 8px;
    background: var(--color-bg-surface);
    color: var(--color-text-muted);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    padding: 0 12px;
  }

  .filters button.active {
    border-color: var(--color-accent);
    background: var(--color-bg-accent-soft);
    color: var(--color-accent-strong);
  }

  .result-groups {
    display: grid;
    gap: 20px;
  }

  .result-group {
    display: grid;
    gap: 12px;
  }

  .result-group h2 {
    margin: 0;
    color: var(--color-text-strong);
    font-size: 1.2rem;
  }

  .group-note {
    max-width: none;
    border-left: 3px solid var(--color-accent);
    background: var(--color-bg-accent-softer);
    color: var(--color-text-group-note);
    font-size: 0.95rem;
    line-height: 1.5;
    padding: 10px 14px;
  }

  .cards {
    display: grid;
    gap: 10px;
  }

  .result-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border: 1px solid var(--color-border-card);
    border-radius: 8px;
    background: var(--color-bg-surface);
    padding: 16px;
  }

  .result-card h3 {
    margin: 3px 0 0;
    color: var(--color-text-strong);
    font-size: 1rem;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .kind-label {
    color: var(--color-accent);
    font-size: 0.84rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .card-actions a {
    display: inline-block;
    padding: 8px 0;
    color: var(--color-accent-strong);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }

  .empty-group {
    max-width: none;
    border: 1px dashed var(--color-border-default);
    border-radius: 8px;
    background: var(--color-bg-surface-muted);
    color: var(--color-text-subtle);
    padding: 14px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .search-hero {
      transition: padding 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

    .filters button {
      transition:
        background-color 160ms ease,
        border-color 160ms ease,
        color 160ms ease;
    }

    @keyframes resultCardIn {
      from {
        opacity: 0;
        transform: translateY(4px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    .result-card {
      animation: resultCardIn 220ms ease both;
      animation-delay: var(--result-delay, 0ms);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-hero,
    .filters button,
    .result-card {
      animation: none;
      transition: none;
    }
  }

  @media (max-width: 720px) {
    .search-hero {
      align-content: start;
      padding: 64px 0 72px;
    }

    .search-experience[data-has-results="true"] .search-hero {
      padding: 64px 0 72px;
    }

    .search-copy {
      justify-items: start;
      text-align: left;
    }

    .suggestion-text {
      display: grid;
      gap: 3px;
    }

    .suggestion-text strong,
    .suggestion-text span {
      white-space: normal;
    }

    .result-card,
    .results-status.error {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

---
import { SearchExperience } from "@/components/SearchExperience";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Ясли" description="Търсене на ясли и детски градини по адрес във Варна.">
  <SearchExperience client:load />
</BaseLayout>

<style is:global>
  .search-experience {
    display: grid;
    min-height: 100%;
    grid-template-rows: 1fr auto;
    /* Transparent on purpose: an opaque fill here would paint over the three
       section-hue tint circles that live behind the page. */
    background: transparent;
  }

  .search-experience[data-has-results="true"] {
    grid-template-rows: auto 1fr;
  }

  .search-hero {
    display: grid;
    width: min(100% - 32px, 760px);
    align-content: start;
    justify-self: center;
    padding: max(48px, 32vh) 0 30px;
  }

  .search-experience[data-has-results="true"] .search-hero {
    padding: 48px 0 30px;
  }

  .search-copy {
    display: grid;
    gap: 20px;
    justify-items: center;
    margin-bottom: 26px;
    text-align: center;
  }

  .search-copy h1 {
    max-width: 760px;
    margin: 0;
    color: var(--color-text-display);
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.01em;
  }

  .search-copy h1 em {
    font-style: italic;
    color: var(--color-section-nursery);
  }

  /* A printed highlight under the noun, in the kindergarten hue. */
  .search-copy h1 .headline-mark {
    box-shadow: inset 0 -0.1em 0 rgba(43, 82, 201, 0.35);
  }

  .search-copy p {
    max-width: 54ch;
    color: var(--color-text-muted);
    font-size: 1.02rem;
    line-height: 1.62;
  }

  .search-panel {
    position: relative;
    width: 100%;
  }

  .search-field {
    display: grid;
    min-height: 62px;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 14px;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-control);
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-field);
    color: var(--color-section-nursery);
    padding: 0 26px;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  /* The field shifts into its own printed shadow on focus. */
  .search-field:focus-within {
    transform: translate(2px, 2px);
    box-shadow: var(--shadow-hard-sm);
  }

  .search-field input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-text-strong);
    font: inherit;
    font-size: 1.02rem;
    /* 700 was body weight on an input — the design puts weight on the card
       names instead. */
    font-weight: 500;
  }

  .search-field input::placeholder {
    color: var(--color-text-faint);
    font-weight: 400;
  }

  .suggestion-panel {
    position: absolute;
    z-index: 10;
    top: calc(100% + 12px);
    left: 0;
    width: 100%;
    max-height: min(376px, 52dvh);
    overflow-y: auto;
    border: 2px solid var(--color-ink);
    border-radius: 18px;
    margin: 0;
    padding: 8px;
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-panel);
    list-style: none;
  }

  .suggestion-panel li {
    display: grid;
    min-height: 46px;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    border-radius: 12px;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 11px 14px;
  }

  .suggestion-panel li[data-active] {
    background: var(--color-bg-accent-soft);
    box-shadow: inset 0 0 0 1.5px var(--color-section-nursery);
    color: var(--color-text-strong);
  }

  @media (hover: hover) and (pointer: fine) {
    .suggestion-panel li:hover {
      background: var(--color-bg-accent-softer);
      color: var(--color-text-strong);
    }
  }

  .suggestion-text {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 6px;
  }

  .suggestion-text strong {
    color: var(--color-text-strong);
    font-size: 0.94rem;
    white-space: nowrap;
  }

  .suggestion-text span {
    min-width: 0;
    overflow: hidden;
    color: var(--color-text-subtle);
    font-size: 0.9rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .row-icon,
  .arrow-icon {
    flex: 0 0 auto;
  }

  .status-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--color-text-muted);
    font-size: 0.94rem;
  }

  .status-panel button,
  .results-status button {
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-control);
    background: var(--color-accent);
    color: var(--color-text-on-accent);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    padding: 9px 16px;
    box-shadow: var(--shadow-hard-sm);
    transition:
      transform 140ms ease,
      box-shadow 140ms ease;
  }

  .status-panel button:hover,
  .results-status button:hover {
    transform: translate(1px, 1px);
    box-shadow: 2px 2px 0 var(--color-ink);
  }

  .validation-message {
    margin-top: 12px;
    color: var(--color-text-error-strong);
    font-size: 0.94rem;
    font-weight: 600;
  }

  .freshness-line {
    max-width: none;
    margin-top: 16px;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    text-align: center;
  }

  .results-area {
    width: min(100% - 32px, 1040px);
    justify-self: center;
    padding: 0 0 56px;
  }

  .selected-address {
    max-width: none;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .results-status,
  .stale-banner {
    border: 2px solid var(--color-border-card);
    border-radius: var(--radius-surface);
    margin-top: 18px;
    background: var(--color-bg-surface);
    color: var(--color-text-muted);
    padding: 16px 18px;
  }

  .results-status.error,
  .stale-banner {
    border-color: var(--color-border-error);
    background: var(--color-bg-error-soft);
    color: var(--color-text-error);
    font-weight: 500;
  }

  .results-status.error {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0;
  }

  .filters button {
    min-height: 44px;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-control);
    background: var(--color-bg-surface);
    color: var(--color-text-strong);
    cursor: pointer;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 0 18px;
    box-shadow: var(--shadow-hard-sm);
  }

  .filters button:hover {
    transform: translate(1px, 1px);
    box-shadow: 2px 2px 0 var(--color-ink);
  }

  .filters button.active {
    background: var(--color-ink);
    color: var(--color-bg-page);
    box-shadow: 3px 3px 0 var(--color-section-nursery);
  }

  .result-groups {
    display: grid;
    gap: 20px;
  }

  .result-group {
    display: grid;
    gap: 12px;
    /* Each group resolves one hue, then everything inside reads from it. */
    --tone: var(--color-section-nursery);
  }

  .result-group[data-kind="kindergarten"] {
    --tone: var(--color-section-kindergarten);
  }

  .result-group[data-kind="preschool"] {
    --tone: var(--color-section-preschool);
  }

  .result-group h2 {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.1;
  }

  .result-group h2 .group-count {
    background: var(--tone);
    border-radius: 999px;
    color: #ffffff;
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    transform: translateY(-4px);
  }

  .group-rule {
    height: 3px;
    border-radius: 2px;
    background: var(--tone);
    margin-bottom: 6px;
  }

  .group-note {
    max-width: none;
    border-left: 4px solid var(--tone);
    border-radius: 0 12px 12px 0;
    background: var(--color-bg-surface-muted);
    color: var(--color-text-muted);
    font-size: 0.94rem;
    line-height: 1.55;
    padding: 13px 16px;
  }

  .group-note--warn {
    border-left-color: var(--color-section-nursery);
    background: var(--color-bg-warn-soft);
    color: var(--color-text-warn);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(268px, 1fr));
    gap: 16px;
  }

  .result-card {
    position: relative;
    display: flex;
    /* Column, so a long institution name gets the full card width and the
       source link sits beneath it rather than competing for the same row. */
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 12px;
    overflow: hidden;
    border: 2px solid var(--color-border-card);
    border-radius: var(--radius-surface);
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-hard);
    padding: 20px 18px 16px;
    transition:
      transform 180ms cubic-bezier(0.2, 0.8, 0.3, 1),
      box-shadow 180ms ease;
  }

  .result-card:hover {
    transform: translate(-2px, -3px);
    box-shadow: 8px 9px 0 var(--tone);
  }

  /* An outline numeral bedded into the card, behind the content. */
  .result-index {
    position: absolute;
    right: 8px;
    bottom: -22px;
    color: transparent;
    font-family: var(--font-display);
    font-size: 5.4rem;
    font-weight: 700;
    line-height: 1;
    pointer-events: none;
    -webkit-text-stroke: 1.5px rgba(32, 28, 23, 0.13);
  }

  /* Attribute-free on purpose — SearchResults.test.tsx asserts the bare tag. */
  .result-card h3 {
    position: relative;
    margin: 0 0 5px;
    color: var(--color-text-strong);
    font-size: 1.06rem;
    font-weight: 700;
    letter-spacing: -0.012em;
    line-height: 1.32;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .kind-label {
    margin: 0 0 8px;
    color: var(--tone);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .match-basis {
    position: relative;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.84rem;
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
  }

  .card-actions a {
    position: relative;
    display: inline-block;
    padding: 8px 0 2px;
    border-bottom: 2px solid var(--tone);
    color: var(--color-text-strong);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .card-actions a:hover {
    color: var(--tone);
  }

  .empty-group {
    max-width: none;
    border: 2px dashed rgba(32, 28, 23, 0.32);
    border-radius: var(--radius-surface);
    background: var(--color-bg-surface-muted);
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    padding: 20px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .search-hero {
      transition: padding 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }

    .filters button {
      transition:
        background-color 160ms ease,
        border-color 160ms ease,
        color 160ms ease;
    }

    @keyframes resultCardIn {
      from {
        opacity: 0;
        transform: translateY(4px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    .result-card {
      animation: resultCardIn 220ms ease both;
      animation-delay: var(--result-delay, 0ms);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-hero,
    .filters button,
    .result-card,
    .search-field,
    .status-panel button,
    .results-status button {
      animation: none;
      transition: none;
    }
  }

  @media (max-width: 720px) {
    .search-hero {
      align-content: start;
      padding: 64px 0 72px;
    }

    .search-experience[data-has-results="true"] .search-hero {
      padding: 64px 0 72px;
    }

    .search-copy {
      justify-items: start;
      text-align: left;
    }

    .freshness-line {
      text-align: left;
    }

    .suggestion-text {
      display: grid;
      gap: 3px;
    }

    .suggestion-text strong,
    .suggestion-text span {
      white-space: normal;
    }

    .results-status.error {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
